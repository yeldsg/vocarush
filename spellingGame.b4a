#Region  Activity Attributes 
    #FullScreen: True
    #IncludeTitle: False
#End Region

Sub Process_Globals
	Public playerList As List
End Sub

Sub Globals
	Private BTN_ENTER As Button
	Private ET_PNAME As EditText
	
End Sub

Sub Activity_Create(FirstTime As Boolean)
	Activity.LoadLayout("mainPage")
	
	If playerList.IsInitialized = False Then playerList.Initialize
	Database.Init
End Sub

Private Sub BTN_ENTER_Click
	If ET_PNAME.Text = "" Then
		MsgboxAsync("Please enter your name", "WARNING")
	Else
		playerList.Add(ET_PNAME.Text)
		ToastMessageShow("Added Player: " & ET_PNAME.Text, False)
		Level.PlayerName = ET_PNAME.Text
		ET_PNAME.Text = ""
		StartActivity(Level)
	End If
End Sub


